# Copy to .env on the VM and fill in. .env is never committed.
# plutus's admin routes (LAN) and the token in its gluttonyAdminConfig.json
ADMIN_TOKEN=
ADMIN_HOST=
ADMIN_PORT=5000
# user@host that rsync sends pictures to (plutus, LAN)
UPLOAD_HOST=
# "dry" runs every stage but sending; "on" publishes. Only the owner turns it on.
PUBLISH=dry
# "on" runs the weekly pass (Sunday 03:00 Central) by itself
SCHEDULE=off
# Surrogate's control API
CONTROL_TOKEN=
CONTROL_PORT=5057
